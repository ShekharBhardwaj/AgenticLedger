.DS_Store
.claude/
CLAUDE.md

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging/build artifacts (dist/.gitkeep stays tracked so a cold
# `docker build` always has a dist/ directory to COPY)
build/
dist/*
!dist/.gitkeep
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime database artifacts (never commit captured LLM traffic)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Web app (dashboard-app builds into agenticledger/proxy/static/)
dashboard-app/node_modules/
agenticledger/proxy/static/
